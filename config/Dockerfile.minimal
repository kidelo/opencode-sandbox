# ==========================================================================
# Dockerfile.minimal — harness-only sandbox image.
#
# Builds on the precompiled shared base image `ocs-base` (see base.Dockerfile,
# created by `ocs rebuild` before this file is built). `ocs-base` already has
# the Debian base, the common apt set (squid/iptables/gosu/… the sandbox
# harness), the `dev` user + dirs, the opencode CLI, and the xdg-open stub.
# This profile adds only what the minimal profile uniquely wants: nothing.
# The per-project squid / firewall config, the opencode password, and the
# entrypoint are layered on here (they are project/profile-specific).
#
# What it gives you:
#   - The opencode-sandbox skeleton (squid egress proxy + iptables firewall
#     + gosu privilege drop + the opencode CLI)
#   - python3 (Debian's own; NO pip packages — the agent has its own runtime)
#   - /dev user, $WORKSPACE_DIR, /home/dev/.{local,config,cache}
#   - The headless xdg-open stub
#
# What it does NOT give you:
#   - no npm/pnpm/uv toolchain (use a different profile for that)
#   - no office/PDF/OCR/science/geo/ML libs
#   - no sudo, no docker, no wireshark, no large CLI suites
#
# Use it when: you want the smallest possible attack surface for a project
# that doesn't need the full toolchain. It is the DEFAULT profile (when a
# project's config does not set `dockerfile:`, ocs rebuild uses this one).
# ==========================================================================

# FROM ocs-base — the precompiled shared base (base.Dockerfile) already carries
# the Debian base, the common apt set (the sandbox harness), the `dev` user +
# dirs, the opencode CLI, the xdg-open stub, and the ENV/WORKDIR. Nothing below
# needs to re-declare them.
FROM ocs-base

# Minimal is exactly the harness: the only things this profile adds are the
# per-project squid / firewall config, the opencode password, and the
# entrypoint — all layered on the precompiled base. No profile-specific apt
# packages or pip installs — that is the point of minimal.

# --- squid proxy configuration ----------------------------------------------
# Per-project (from squid-whitelist.txt) — kept out of the shared base so the
# base stays reusable across projects.
COPY squid.conf /etc/squid/squid.conf
COPY squid-whitelist.txt /etc/squid/squid-whitelist.txt

# --- firewall configuration ---------------------------------------------------
# Per-project (host-ports / intranet-endpoints / agent-dns) — project-specific,
# so layered here rather than baked into the shared base.
COPY host-ports.txt /etc/host-ports.txt
COPY intranet-endpoints.txt /etc/intranet-endpoints.txt
COPY agent-dns /etc/agent-dns
COPY landlock /etc/landlock
COPY egress-audit /etc/egress-audit

# --- landlock kernel-boundary helper (opt-in) ---------------------------------
# `landlock: on` in the project config makes the entrypoint run this helper at
# startup to enforce a write boundary on top of the ro mounts / caps drop.
# Baked to a neutral path (no `test` suffix) so the same helper works in all
# three profiles without the name implying test-only.
COPY landlock.py /opt/ocs/landlock.py
RUN chmod 0644 /opt/ocs/landlock.py

# --- opencode password + entrypoint ------------------------------------------
COPY opencode-password /opencode-password
COPY entrypoint.sh /entrypoint.sh
# The entrypoint (root) is the sole reader — it seeds OPENCODE_SERVER_PASSWORD;
# gosu passes that to dev as env. dev never reads the file. Keep it root 0600
# so the container does not require the DAC_OVERRIDE capability.
RUN chown root:root /opencode-password \
    && chmod 600 /opencode-password \
    && chmod +x /entrypoint.sh

WORKDIR ${WORKSPACE_DIR}
ENTRYPOINT ["/entrypoint.sh"]
