# ==========================================================================
# Dockerfile.test — image exclusively for `ocs test`.
#
# NOT selectable by a project: `ocs init` / `ocs rebuild` refuse the `test`
# profile. The `ocs test` command builds this image under a separate tag
# (`ocs-<SANDBOX_ID>-test`) so it never clobbers the project's working image.
#
# Builds on the precompiled shared base image `ocs-base` (base.Dockerfile,
# created by `ocs rebuild` before any profile is built). `ocs-base` already
# has the Debian base, the common apt set (the sandbox harness: squid/
# iptables/gosu/iproute2/iputils-ping/netcat-openbsd/dnsutils/whois), the
# `dev` user + dirs, the opencode CLI, and the xdg-open stub. This profile
# adds ONLY the network-analysis toolbox + `jq` (plus the reserved
# harness egress args and the listener) that the test suite needs.
# ============================================================================

FROM ocs-base

# USER_ID / GROUP_ID: the base image already baked in the dev user with these
# IDs (`ocs-base` was built with the same `--build-arg USER_ID/GROUP_ID`), so
# the profile build needs them only to `chown /mnt/ocs-fwd` below. The rest of
# the harness (apt set, `dev` dirs, opencode CLI, xdg-open stub, ENV) comes
# prebuilt from the ocs-base image.
ARG USER_ID
ARG GROUP_ID
# --- test-harness egress targets (TEST image only, never selectable) -------
# ocs-test builds this image with these args so the image itself declares the
# egress targets whose allow-rules it will test (baked by the entrypoint from
# /etc/intranet-endpoints.txt and /etc/host-ports.txt into iptables):
#   HARNESS_EP_IP/HARNESS_EP_PORT  — the sandbox-net IP:port of the runner's
#                                    intranet endpoint listener container.
#   HARNESS_HOST_PORT              — the host-published port of the runner's
#                                    host-ports listener (reached via docker.host).
# Absent/empty args add nothing — the image behaves like the profiles.
ARG HARNESS_EP_IP=""
ARG HARNESS_EP_PORT=8765
ARG HARNESS_HOST_PORT=8766

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# --- profile-specific apt (network analysis + jq) --------------------------
# Already in ocs-base (do NOT re-declare): build-essential, curl,
#   ca-certificates, git, xdg-utils, gosu, procps, squid, iptables, iproute2,
#   iputils-ping, netcat-openbsd, dnsutils, whois.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        net-tools \
        traceroute \
        mtr-tiny \
        nmap \
        tcpdump \
        jq \
    && rm -rf /var/lib/apt/lists/*

# --- squid proxy configuration ----------------------------------------------
COPY squid.conf /etc/squid/squid.conf
COPY squid-whitelist.txt /etc/squid/squid-whitelist.txt

# --- firewall configuration ---------------------------------------------------
COPY host-ports.txt /etc/host-ports.txt
COPY intranet-endpoints.txt /etc/intranet-endpoints.txt
COPY agent-dns /etc/agent-dns
COPY landlock /etc/landlock
COPY egress-audit /etc/egress-audit

# --- landlock helper (opt-in; same neutral path as minimal/full so cases can
#     run in any profile) ------------------------------------------------------
COPY landlock.py /opt/ocs/landlock.py
RUN chmod 0644 /opt/ocs/landlock.py

# --- test-harness egress targets (baked from the build args above) -----------
# Appended to the allow-lists the entrypoint reads at start, so this TEST image
# alone can be reached at the runner's positive-egress targets. The working
# profiles (minimal/full) never set these args — they stay empty — so this can
# never leak into a project's working image or its firewall.
# LAYER ORDER MATTERS: this RUN must come AFTER the COPYs of the two
# allow-lists above (otherwise the COPY would overwrite the RUN's output
# with the project's own files, and the baked harness EP / host port would
# never make it into /etc, so no ACCEPT rule would be installed and the
# positive egress cases 15/16 would fail).
RUN if [ -n "${HARNESS_EP_IP}" ]; then \
        echo "${HARNESS_EP_IP}:${HARNESS_EP_PORT}" >> /etc/intranet-endpoints.txt; \
    fi && \
    if [ -n "${HARNESS_HOST_PORT}" ]; then \
        echo "${HARNESS_HOST_PORT}" >> /etc/host-ports.txt; \
    fi
# Landing dir for the volume-mount test case (case 14). NOTE: this dir
# existing/writable in the image alone is NOT proof of the -v mount —
# ocs-test detects the mount via the sentinel file the runner writes
# into its host-side temp dir (checked by case 14 against FWD_TEST_SENTINEL).
RUN mkdir -p /mnt/ocs-fwd && chown "${USER_ID}:${GROUP_ID}" /mnt/ocs-fwd

# --- ocs test harness listener ------------------------------------------------
# Baked in (by ocs-rebuild-container, which COPYs it into the build context
# ONLY for the test profile) so the runner's positive-egress listener
# containers can run it via OPCODE_CMD without any host-side mount:
#   OPCODE_CMD="python3 /opt/ocs-test/listener.py <port>"
COPY listener.py /opt/ocs-test/listener.py
RUN chmod 0644 /opt/ocs-test/listener.py

# --- opencode password + entrypoint ------------------------------------------
COPY opencode-password /opencode-password
COPY entrypoint.sh /entrypoint.sh
RUN chown root:root /opencode-password \
    && chmod 600 /opencode-password \
    && chmod +x /entrypoint.sh

WORKDIR ${WORKSPACE_DIR}
ENTRYPOINT ["/entrypoint.sh"]
