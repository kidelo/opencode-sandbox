# ==========================================================================
# Dockerfile.test — image exclusively for `ocs test`.
#
# Not selectable by a project: `ocs init` / `ocs rebuild` refuse the
# `test` profile. The `ocs test` command builds this image under a
# separate tag (`ocs-<SANDBOX_ID>-test`) so it never clobbers
# the project's working image.
#
# Contains the full network-analysis toolbox the red-team and the host
# cases need:
#   - nmap, tcpdump, iputils-ping, netcat, dnsutils, whois, traceroute,
#     mtr, net-tools (ifconfig/route legacy)
#   - python3 + jq  (cases 03/08/09 parse JSON / IP math)
#   - everything the harness needs (squid, iptables, gosu, opencode)
# ==========================================================================

FROM python:3.13-slim-bookworm

ARG USER_ID
ARG GROUP_ID
ARG WORKSPACE_DIR=/workspace
# --- test-harness egress targets (TEST image only, never selectable) -------
# ocs-test builds this image with these args so the image itself declares the
# egress targets whose allow-rules it will test (baked by the entrypoint from
# /etc/intranet-endpoints.txt and /etc/host-ports.txt into iptables):
#   HARNESS_EP_IP/HARNESS_EP_PORT  — the sandbox-net IP:port of the runner's
#                                    intranet endpoint listener container.
#   HARNESS_HOST_PORT              — the host-published port of the runner's
#                                    host-ports listener (reached via docker.host).
# Absent/empty args add nothing — the image behaves like the profiles.
ARG HARNESS_EP_IP=""
ARG HARNESS_EP_PORT=8765
ARG HARNESS_HOST_PORT=8766

ENV WORKSPACE_DIR=${WORKSPACE_DIR} \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# --- OS packages -----------------------------------------------------------
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        ca-certificates \
        git \
        xdg-utils \
        gosu \
        procps \
        # --- sandbox harness ---
        squid \
        iptables \
        # --- network analysis (for ocs test red-team) ---
        iproute2 \
        net-tools \
        iputils-ping \
        netcat-openbsd \
        dnsutils \
        whois \
        traceroute \
        mtr-tiny \
        nmap \
        tcpdump \
        # --- scripting / parsing for the test cases ---
        jq \
    && rm -rf /var/lib/apt/lists/*

# --- user / group ----------------------------------------------------------
RUN if ! getent group ${GROUP_ID} > /dev/null 2>&1; then groupadd -g ${GROUP_ID} dev; fi
RUN if ! getent passwd ${USER_ID} > /dev/null 2>&1; then \
    useradd -m -l -u ${USER_ID} -g ${GROUP_ID} --shell /bin/bash dev; \
fi

# --- workspace + user dirs ---------------------------------------------------
# /etc/opencode — ro mount point for config/opencode.jsonc (opencode reads it,
# cannot rewrite it).
RUN mkdir -p /etc/opencode
RUN mkdir -p "${WORKSPACE_DIR}" /home/dev/.local /home/dev/.config /home/dev/.cache \
    && chown -R "${USER_ID}:${GROUP_ID}" "${WORKSPACE_DIR}" /home/dev/.local /home/dev/.config /home/dev/.cache

# --- opencode CLI ------------------------------------------------------------
RUN curl -fsSL https://opencode.ai/install | bash -s -- --no-modify-path \
    && cp /root/.opencode/bin/opencode /usr/local/bin/opencode \
    && chown "${USER_ID}:${GROUP_ID}" /usr/local/bin/opencode \
    && chmod a+rx /usr/local/bin/opencode

# --- headless xdg-open stub --------------------------------------------------
RUN printf '#!/bin/sh\nexit 0\n' > /usr/local/bin/xdg-open \
    && chmod +x /usr/local/bin/xdg-open

# --- squid proxy configuration ----------------------------------------------
COPY squid.conf /etc/squid/squid.conf
COPY squid-whitelist.txt /etc/squid/squid-whitelist.txt

# --- firewall configuration ---------------------------------------------------
COPY host-ports.txt /etc/host-ports.txt
COPY intranet-endpoints.txt /etc/intranet-endpoints.txt
COPY agent-dns /etc/agent-dns

# --- test-harness egress targets (baked from the build args above) -----------
# Appended to the allow-lists the entrypoint reads at start, so this TEST image
# alone can be reached at the runner's positive-egress targets. The working
# profiles (minimal/full) never set these args — they stay empty — so this can
# never leak into a project's working image or its firewall.
RUN if [ -n "${HARNESS_EP_IP}" ]; then \
        echo "${HARNESS_EP_IP}:${HARNESS_EP_PORT}" >> /etc/intranet-endpoints.txt; \
    fi && \
    if [ -n "${HARNESS_HOST_PORT}" ]; then \
        echo "${HARNESS_HOST_PORT}" >> /etc/host-ports.txt; \
    fi
# Landing dir for the volume-mount test case (case 14).
RUN mkdir -p /mnt/ocs-fwd && chown "${USER_ID}:${GROUP_ID}" /mnt/ocs-fwd

# --- ocs test harness listener ------------------------------------------------
# Baked in (by ocs-rebuild-container, which COPYs it into the build context
# ONLY for the test profile) so the runner's positive-egress listener
# containers can run it via OPCODE_CMD without any host-side mount:
#   OPCODE_CMD="python3 /opt/ocs-test/listener.py <port>"
COPY listener.py /opt/ocs-test/listener.py
RUN chmod 0644 /opt/ocs-test/listener.py

# --- opencode password + entrypoint ------------------------------------------
COPY opencode-password /opencode-password
COPY entrypoint.sh /entrypoint.sh
RUN chown root:root /opencode-password \
    && chmod 600 /opencode-password \
    && chmod +x /entrypoint.sh

WORKDIR ${WORKSPACE_DIR}
ENTRYPOINT ["/entrypoint.sh"]
