{
  "$schema": "https://opencode.ai/config.json",
  // Always run the sandbox model (CLI paths also pin it via -m)
  "model": "ollama/ornith-1.5:9b",

  // Sandboxes are ephemeral one-shot containers — no auto-update (the
  // sandbox firewall would deny the update egress anyway).
  "update": "disable",

  // OpenCode 2.3.2: keep a share of the model's context window free for
  // compaction (percentage form — one value fits the 128k-token window and
  // any future model). Longer agent runs survive near-full context.
  "compaction": {
    "buffer": "20%"
  },

  // V2: the V1 `small_model` key becomes the built-in `title` agent's model.
  "agents": {
    "title": {
      "model": "ollama/ornith-1.5:9b"
    }
  },

  // V2: top-level `subagent_depth` moved under `experimental`; `todo` enables
  // the V1-era `todowrite` tool (dropped from the default tool set in V2 —
  // off by default). Verified on 2.1.2: with this key the model can call
  // `todowrite` and the TUI renders the task list.
  "experimental": {
    "subagent_depth": 2,
    "todo": true
  },

  // Only the ollama provider may load — no other provider/model can be used.
  // (V2 normalizes the V1 `enabled_providers` provider filter in memory.)
  "enabled_providers": ["ollama"],

  // V2: singular `provider` -> plural `providers`; `npm` -> `package` (AI SDK
  // packages keep the `aisdk:` prefix); `options` -> `settings`.
  "providers": {
    "ollama": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Ollama",
      "settings": {
        // Your local model server (Ollama). Use "ollama" (default) for the
        // official ollama.ai cloud, or point at your own instance.
        // CHANGE-ME: this repo ships a self-hosted Ollama address; point it
        // at your own instance (ip:port) before using the sandbox.
        "baseURL": "http://192.168.0.139:11434/v1",
        "timeout": 600000,
        "chunkTimeout": 600000
      },
      // The model catalog — the single common source for BOTH engines.
      // opencode reads this map directly (V2 `providers.ollama.models`).
      // pi-agent reads the same catalog (translated into its per-model
      // models.json schema at build time, with the `pi-base-url:` host:port
      // injected into the baseUrl). Edit this map once; both engines follow.
      "models": {
        "ornith-1.5:9b": {
          "name": "Ornith 1.5 9B",
          "modelID": "ornith-1.5:9b",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "lfm3:1.7b-q8_0": {
          "name": "LFM3 1.7B Q8",
          "modelID": "lfm3:1.7b-q8_0",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "qwen3.8-27b": {
          "name": "Qwen3.8 27B IQ3",
          "modelID": "hf.co/bartowski/Qwen3.8-27B-GGUF:IQ3_XXS",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "gemma4:e4b": {
          "name": "Gemma4 E4B",
          "modelID": "gemma4:e4b",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "bonsai-2:9b": {
          "name": "Bonsai-2 9B",
          "modelID": "bonsai-2:9b",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "mimo-v2.6:latest": {
          "name": "MiMo v2.6",
          "modelID": "mimo-v2.6:latest",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        }
      }
    }
  },

  // V2: the V1 `permission` object becomes the ordered `permissions` array.
  // Action renames: bash -> shell, task -> subagent, write/patch -> edit.
  "permissions": [
    // The container's own firewall/mounts are the real security boundary —
    // let the agent attempt things outside the workspace so those controls
    // are what actually stop it (used by the ocs-test red-team).
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },
    // No web access per default — the sandbox firewall already denies
    // all non-whitelisted egress, the tool denies as defense in depth.
    { "action": "webfetch", "resource": "*", "effect": "deny" },
    { "action": "websearch", "resource": "*", "effect": "deny" }
  ]
}
