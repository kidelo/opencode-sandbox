# ==========================================================================
# Dockerfile.pi-mini — thin per-project tail for the pi one-shot door.
#
# Builds on the precompiled "lean pi" base image `ocs-base-pi-minimal`
# (base-pi-minimal.Dockerfile, created by `ocs rebuild` before this file is
# built). That base already carries: the Debian base + the common sandbox-
# harness apt set (squid/iptables/gosu/…) + the `dev` user + dirs + the git-
# hook neutralization + the xdg-open stub + the prebuilt Node.js toolchain +
# the baked pi-agent managed tree (pi CLI + pi-subagents + pi-lens +
# pi-memory) (so `pi --print --offline` resolves the model with no internet).
#
# This profile adds ONLY the PER-PROJECT configuration variables: the squid
# whitelist/config, host-ports, intranet-endpoints, agent-dns, landlock helper,
# the models.json (from the PI_BASE_URL build arg), and the entrypoint.
#
# NOTE: unlike the opencode profiles, there is NO /opencode-password block —
# pi is a separate engine with no web server / basic-auth password. The
# entrypoint pi-guards the password block line (it never reads /opencode-
# password for pi).
#
# Layers: python:3.13-slim-bookworm <- ocs-base-pi-minimal <- THIS (tail)
# ==========================================================================

# FROM ocs-base-pi-minimal — the precompiled lean pi base already carries the
# Debian base, the common apt set (the sandbox harness), the prebuilt Node.js
# + npm toolchain, the baked pi-agent managed tree, the `dev` user + dirs, and
# the git-hook neutralization + xdg-open stub (plus any pi-plugins: entries,
# baked at build time by the block below). Nothing else is re-declared here.
FROM ocs-base-pi-minimal

# USER_ID/GROUP_ID: the dev user already exists in the base; the base ARGs
# do not survive FROM, so re-declare them here to `chown` models.json below.
# The tail build (bin/ocs-rebuild-container) already passes them as build
# args. PI_BASE_URL: the models.json baseUrl — REQUIRED, validated by
# `ocs rebuild` (required for pi projects; the URL's host:port must be in the
# project's intranet-endpoints:). The container has no runtime internet, so
# models.json is the only way the pi engine resolves the model.
ARG USER_ID
ARG GROUP_ID
ARG PI_BASE_URL=""

# --- models.json (multi-model catalog, derived from config/opencode.jsonc) -----
# The pi engine bakes its model list from a derived models.json (an ARRAY of
# {id,name,contextWindow,maxTokens}) — NOT from the read-only opencode.jsonc
# mount. This file is derived host-side at `ocs rebuild` from the common
# "providers.ollama.models" catalog (bin/ocs-rebuild-container ->
# build_pi_models_json()) and committed into the build context as
# pi-models.json, then COPY'd in here. The baseUrl baked into it is the
# staged pi-base-url (validated by `ocs rebuild`; must be in intranet-endpoints:).
# opencode projects pass an empty PI_BASE_URL and skip this whole bake, so this
# RUN stays a no-op for them — the guard is only here to fail fast on a pi
# project that forgot to set 'pi-base-url:'.
ARG PI_BASE_URL=""
# pi-models.json is the derived per-project models.json — a real build-context
# file (bin/ocs-rebuild-container -> build_pi_models_json), NOT something a RUN
# can generate: a RUN runs on the container filesystem and cannot see the
# build context. COPY it in, then fix ownership/permissions.
COPY pi-models.json /opt/ocs/pi-agent/models.json
RUN chown "${USER_ID}:${GROUP_ID}" /opt/ocs/pi-agent/models.json \
    && chmod 0644 /opt/ocs/pi-agent/models.json

# --- squid proxy configuration ----------------------------------------------
COPY squid.conf /etc/squid/squid.conf
COPY squid-whitelist.txt /etc/squid/squid-whitelist.txt

# --- firewall configuration ---------------------------------------------------
COPY host-ports.txt /etc/host-ports.txt
COPY intranet-endpoints.txt /etc/intranet-endpoints.txt
COPY agent-dns /etc/agent-dns
COPY landlock /etc/landlock
COPY egress-audit /etc/egress-audit

# --- landlock kernel-boundary helper (opt-in) ---------------------------------
COPY landlock.py /opt/ocs/landlock.py
RUN chmod 0644 /opt/ocs/landlock.py

# --- per-project pi plugins (`pi-plugins:` config key) -------------------------
# pi-plugins.txt (space-separated `npm:<spec>` sources, validated by
# `ocs rebuild`) is baked here: extra plugins must already be in the image —
# the container has no runtime internet (pi itself runs `--print --offline`).
# (pi-subagents@0.89.2 is in both pi bases already.)
COPY pi-plugins.txt /tmp/pi-plugins.txt
RUN set -e ; \
    for p in $(cat /tmp/pi-plugins.txt); do \
      PI_CODING_AGENT_DIR=/opt/ocs/pi-agent /opt/ocs/pi-agent/bin/pi install "${p}" ; \
    done
RUN rm -f /tmp/pi-plugins.txt

# --- entrypoint ---------------------------------------------------------------
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

WORKDIR ${WORKSPACE_DIR}
ENTRYPOINT ["/entrypoint.sh"]
