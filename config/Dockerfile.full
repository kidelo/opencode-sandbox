# ==========================================================================
# Dockerfile.full — full dev-toolchain sandbox image (thin per-project tail).
#
# Builds on the precompiled `full` pseudo-base `ocs-base-full`
# (base-full.Dockerfile, created by `ocs rebuild` before this file is built).
# `ocs-base-full` already carries everything expensive: the Debian base +
# the common sandbox-harness apt set, the `dev` user + dirs, the opencode
# CLI, the xdg-open stub (all inherited from `ocs-base`) PLUS the full dev
# toolchain (shellcheck, CSV/OCR/PDF/graphviz/fonts/native-libs apt set) and
# the large `pip` data/office/PDF/OCR/sci stack.
#
# This profile therefore only adds the PER-PROJECT configuration variables:
# the squid whitelist/config, host-ports, intranet-endpoints, agent-dns,
# /opencode-password, and the entrypoint. Those are the "individual docker
# config variables" that vary per project — they stay OUT of the precompiled
# base so the base can be shared by every full-profile project. The build
# is a matter of seconds, not minutes.
#
# Layers: python:3.13-slim-bookworm <- ocs-base <- ocs-base-full <- THIS (tail)
# ==========================================================================

FROM ocs-base-full

# ============================================================================
# SQUID PROXY CONFIGURATION (per-project config variable)
# ============================================================================
COPY squid.conf /etc/squid/squid.conf
COPY squid-whitelist.txt /etc/squid/squid-whitelist.txt

# ============================================================================
# FIREWALL CONFIGURATION (per-project config variables)
# ============================================================================
COPY host-ports.txt /etc/host-ports.txt
COPY intranet-endpoints.txt /etc/intranet-endpoints.txt
COPY agent-dns /etc/agent-dns

# ============================================================================
# OPENCODE PASSWORD / ENTRYPOINT (per-project config variables)
# ============================================================================
COPY opencode-password /opencode-password
COPY entrypoint.sh /entrypoint.sh
# The entrypoint (running as root) is the sole reader of /opencode-password —
# it seeds OPENCODE_SERVER_PASSWORD, which gosu passes to dev as environment.
# dev never reads the file itself. Keep it root-owned 0600 so the container
# does not need the DAC_OVERRIDE capability.
RUN chown root:root /opencode-password \
    && chmod 600 /opencode-password \
    && chmod +x /entrypoint.sh

WORKDIR /workspace
ENTRYPOINT ["/entrypoint.sh"]
