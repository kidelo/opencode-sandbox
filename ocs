#!/usr/bin/env bash
set -euo pipefail

# ocs — single entry point for opencode-sandbox.
#
# Address sandboxes by name — no need to cd into the project first:
#
#   ocs init <name>          Create a new sandbox project at ./sandboxes/<name>/
#   ocs rebuild <name>       Build the container image for <name>
#   ocs start <name>         Web container (one-shot, Ctrl-C stops)
#   ocs tui <name> [-c] [-s ID] [--fork]   Interactive TUI (one-shot);
#                                          resume the last (-c) or a session (-s)
#                                          after an abort, optionally forked (--fork)
#   ocs run <name> <prompt> [args]   One-shot 'opencode run' (prompt file or inline string)
#   ocs web <name>           Open the web UI in the browser
#   ocs web-auth <name>      Open the web UI with a pre-authenticated URL
#   ocs terminal <name>      Attach an opencode session to the running web container
#   ocs test <name>          Security suite (own one-shot container)
#   ocs list                 List sandbox projects
#   ocs status [name]        List sandbox containers on this host (or for one project)
#   ocs logs [name] [flags]  Show/tail a project's container log (flags passed to `docker logs`)
#   ocs clean [name]         Nuclear per-project cleanup (containers + images + network + state)
#   ocs clear [name]         Alias for 'ocs clean'
#   ocs kill [filter]        Remove sandbox containers, images, networks (all projects or filter)
#   ocs help                 Show this help
#
# ocs init is scriptable (no prompts):
#   ocs init -y <name>                     # accept all defaults
#   ocs init -y --dockerfile full <name>   # pick a profile
#   ocs init -y --no-build <name>          # skip the initial build

# If no <name> is given, the project of the current directory is used when it
# is (inside) a sandbox project.

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
BIN_DIR="${SCRIPT_DIR}/bin"
# shellcheck source=bin/shared
source "${BIN_DIR}/shared"

usage() {
  cat <<'EOF'
usage: ocs <command> [project] [args...]

commands:
  init <name> [-y] [--dockerfile <p>] [--no-build]
                         Create a new sandbox project at ./sandboxes/<name>
                         (-y: accept all defaults, no prompts;
                          --dockerfile: image profile; --no-build: skip build)
  rebuild <name>   Build the container image for <name>
  start <name>     Start the one-shot web container (Ctrl+C stops and removes it)
   tui [name] [-c] [-s ID] [--fork]
                         Interactive OpenCode TUI (one-shot). Resume an aborted
                         session: -c/--continue (last), -s/--session <id> (one),
                         --fork (fork before continuing; needs -c or -s). The name
                         may be omitted when run from inside a sandbox project.
  run <name> <prompt> [args]   One-shot opencode run; <prompt> is a prompt
                       file (md) or an inline prompt string
  web <name>       Open the web UI in the browser
  web-auth <name>  Open the web UI in the browser with pre-authenticated basic-auth URL
  terminal <name>  Attach an opencode terminal session to the running web container
  test <name>      Run the security test suite (starts its own one-shot container)
  list             List sandbox projects (./sandboxes/)
  status [name]    List sandbox containers on this host (all, or for one project)
  logs [name] [flags]  Show/tail a project's container log (flags pass to
                       `docker logs`: -f, -n, --since, --tail all, ...)
  clean <name>     Nuclear per-project cleanup: containers + images + network + on-disk state
  clear <name>     Alias for 'clean'
  kill [filter]    Remove sandbox containers, images, and networks (all projects or by name)
  help             Show this help

project is required for most commands; without a name the sandbox project of
the current directory is used.

per-project policy (opencode-sandbox-config.yaml, see README "Per-project policy"):
  cpus: <num>  memory: <Nk|Nm|Ng>  pids: <int>  disk: <Nk|Nm|Ng>  timeout: <sec>  model: <provider/name>
  Defaults when unset: cpus=2.0, memory=4g, pids=256, disk=8g, timeout=0 (none), model=shared.
EOF
}

# resolve_project <explicit-name> [<cmd>]
# Prints the sandbox project dir on stdout.
resolve_project() {
  local name="${1:-}" cmd="${2:-}" proj_dir=""
  if [[ -n "${name}" ]]; then
    if ! valid_sandbox_name "${name}"; then
      echo "ocs: invalid project name '${name}' (lowercase letters, digits, hyphens; must start and end with a letter or digit)." >&2
      return 1
    fi
    proj_dir="${SANDBOXES_BASE}/${name}"
    if [[ ! -f "${proj_dir}/config/opencode-sandbox-config.yaml" ]]; then
      echo "ocs: project '${name}' not found in ${SANDBOXES_BASE}." >&2
      echo "ocs: available projects:" >&2
      list_projects >&2 || true
      return 1
    fi
    printf '%s\n' "${proj_dir}"
    return 0
  fi
  # No explicit name — fall back to the sandbox project of the current dir.
  proj_dir="$(find_sandbox_root 2>/dev/null || true)"
  if [[ -n "${proj_dir}" && -d "${proj_dir}" ]]; then
    printf '%s\n' "${proj_dir}"
    return 0
  fi
  echo "ocs: no project name given and the current directory is not inside a sandbox project." >&2
  echo "ocs: usage: ocs ${cmd} <name>   (see: ocs list)" >&2
  list_projects >&2 || true
  return 1
}

list_projects() {
  local d
  echo "" >&2
  if [[ -d "${SANDBOXES_BASE}" ]]; then
    for d in "${SANDBOXES_BASE}"/*/; do
      [[ -d "${d}" ]] || continue
      local base
      base="$(basename "${d}")"
      if [[ -f "${d%/}/config/opencode-sandbox-config.yaml" ]]; then
        printf '  %s\n' "${base}" >&2
      fi
    done
  fi
}

cmd="${1:-help}"
[[ $# -gt 0 ]] && shift

case "${cmd}" in
  -h|--help|help)
    usage
    ;;
  init)
    exec "${BIN_DIR}/ocs-init" "$@"
    ;;
  list|projects)
    for d in "${SANDBOXES_BASE}"/*/; do
      [[ -d "${d}" ]] || continue
      if [[ -f "${d%/}/config/opencode-sandbox-config.yaml" ]]; then
        printf '%s\n' "$(basename "${d}")"
      fi
    done
    ;;
  status)
    # ocs status [name] — read-only: lists sandbox containers, never starts one.
    # The name is optional (filtered in ocs-status); it lists containers by
    # their shared `ocs-` prefix and accepts a filter substring.
    exec "${BIN_DIR}/ocs-status" "$@"
    ;;
  kill)
    exec "${BIN_DIR}/ocs-kill" "$@"
    ;;
  run)
    # ocs run [name] <prompt>
    # <prompt> is a prompt file (md) or an inline prompt string.
    # If the first argument is a *known* sandbox project, it is the name and the
    # prompt is the next argument(s). Otherwise the first argument is the prompt
    # (file or inline) and the project is resolved from the current directory —
    # the self-hosted pattern: run from inside a sandbox project, e.g.
    #   ocs run "summarise this repo"          # from inside a project
    #   ocs run my-sandbox "summarise this"    # name + inline
    #   ocs run my-sandbox prompts/a.md        # name + file
    run_first="${1:-}"
    [[ $# -gt 0 ]] && shift
    # The first arg is a project NAME only if it is a valid sandbox name AND
    # names an existing project under SANDBOXES_BASE. Otherwise it is the
    # prompt (file or inline) and the project is resolved from the CWD.
    # (Requiring the name shape — same as resolve_project — stops a raw path
    # like ".." or "../x" from being used to select an unintended project.)
    if valid_sandbox_name "${run_first}" && [[ -f "${SANDBOXES_BASE}/${run_first}/config/opencode-sandbox-config.yaml" ]]; then
      run_dir="${SANDBOXES_BASE}/${run_first}"
      [[ $# -gt 0 ]] || { echo "ocs: 'ocs run <name>' needs a prompt (a prompt file or an inline string)." >&2; exit 1; }
      cd "${run_dir}"
      exec "${BIN_DIR}/ocs-run" "$@"
    fi
    # First arg is the prompt (file or inline); resolve the project from CWD.
    run_dir="$(find_sandbox_root 2>/dev/null || true)"
    if [[ -n "${run_dir}" && -d "${run_dir}" ]]; then
      cd "${run_dir}"
      exec "${BIN_DIR}/ocs-run" "${run_first}" "$@"
    fi
    echo "ocs: 'ocs run' needs a project — pass a name ('ocs run <name> <prompt>'), or run from inside a sandbox project ('ocs list' shows names)." >&2
    exit 1
    ;;
  tui|interactive)
    # ocs tui [name] [resume-flags]
    # The resume flags (-c/--continue, -s/--session <id>, --fork) may appear
    # either before or after the project name; the dispatcher re-orders only
    # what it sees (the name, if present) and passes the rest through verbatim.
    # ocs-interactive parses the flags and builds OPCODE_CMD from them.
    # First arg is a project NAME only if it is a valid sandbox name that names
    # an existing project; otherwise it is a flag (e.g. -c, -s, --fork, --help)
    # and the project is resolved from the current directory.
    tui_first="${1:-}"
    [[ $# -gt 0 ]] && shift
    if valid_sandbox_name "${tui_first}" && [[ -f "${SANDBOXES_BASE}/${tui_first}/config/opencode-sandbox-config.yaml" ]]; then
      cd "${SANDBOXES_BASE}/${tui_first}"
      exec "${BIN_DIR}/ocs-interactive" "$@"
    fi
    # No name (or the first arg is a flag) — resolve the project from CWD and
    # pass the first arg back (it is a flag like -c, --session, --fork, --help).
    tui_dir="$(find_sandbox_root 2>/dev/null || true)"
    if [[ -n "${tui_dir}" && -d "${tui_dir}" ]]; then
      cd "${tui_dir}"
      exec "${BIN_DIR}/ocs-interactive" "${tui_first}" "$@"
    fi
    echo "ocs: 'ocs tui' needs a project — pass a name ('ocs tui <name>'), or run from inside a sandbox project ('ocs list' shows names)." >&2
    exit 1
    ;;
  logs)
    # ocs logs [name] [flags...]
    # Show/tail the container log for a project. All flags are passed through
    # to `docker logs` (or `podman logs`) verbatim — that runtime's flag set
    # is authoritative.
    #
    # The first argument is a project NAME only if it is a valid sandbox name
    # that names an existing project under SANDBOXES_BASE; otherwise it is a
    # flag (e.g. -f, -n, --since, --tail all, or a bare name when run outside a
    # project) and the project is resolved from the current directory.
    logs_first="${1:-}"
    [[ $# -gt 0 ]] && shift
    if valid_sandbox_name "${logs_first}" && [[ -f "${SANDBOXES_BASE}/${logs_first}/config/opencode-sandbox-config.yaml" ]]; then
      cd "${SANDBOXES_BASE}/${logs_first}"
      exec "${BIN_DIR}/ocs-logs" "$@"
    fi
    # First arg was a bare word that is NOT a known project — fail loudly
    # instead of silently showing the CURRENT directory's log (which is very
    # confusing: a typo'd name would tail an unrelated project).
    if [[ -n "${logs_first}" && "${logs_first}" != -* ]]; then
      echo "ocs: project '${logs_first}' not found in ${SANDBOXES_BASE}." >&2
      list_projects >&2 || true
      exit 1
    fi
    # First arg was a flag (or missing) — resolve the project from CWD.
    logs_dir="$(find_sandbox_root 2>/dev/null || true)"
    if [[ -n "${logs_dir}" && -d "${logs_dir}" ]]; then
      cd "${logs_dir}"
      if [[ -n "${logs_first}" ]]; then
        exec "${BIN_DIR}/ocs-logs" "${logs_first}" "$@"
      fi
      exec "${BIN_DIR}/ocs-logs" "$@"
    fi
    echo "ocs: 'ocs logs' needs a project — pass a name ('ocs logs <name>'), or run from inside a sandbox project ('ocs list' shows names)." >&2
    exit 1
    ;;
  rebuild|rebuild-container|start|start-container|web|web-auth|terminal|test|clean|clear)
    PROJ_DIR="$(resolve_project "${1:-}" "${cmd}")"
    [[ $# -gt 0 ]] && shift
    cd "${PROJ_DIR}"
    case "${cmd}" in
      rebuild|rebuild-container)   exec "${BIN_DIR}/ocs-rebuild-container" "$@" ;;
      start|start-container)       exec "${BIN_DIR}/ocs-start-container" "$@" ;;
      web)                         exec "${BIN_DIR}/ocs-web" "$@" ;;
      web-auth)                    exec "${BIN_DIR}/ocs-web-auth" "$@" ;;
      terminal)                    exec "${BIN_DIR}/ocs-terminal" "$@" ;;
      test)                        exec "${BIN_DIR}/ocs-test" "$@" ;;
      clean|clear)                 exec "${BIN_DIR}/ocs-clean" ;;
    esac
    ;;
  *)
    echo "ocs: unknown command: ${cmd}" >&2
    echo "" >&2
    usage >&2
    exit 2
    ;;
esac
