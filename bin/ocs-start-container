#!/usr/bin/env bash
set -euo pipefail

# Source common configuration
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "${SCRIPT_DIR}/shared"

use_sandbox_root
print_sandbox_dir

# Source pre-start hook if present (runs on host, may export env vars)
HOOK_PRE_START="${ROOT_DIR}/opencode-sandbox-pre-start-container.sh"
if [[ -f "${HOOK_PRE_START}" ]]; then
  echo ">> sourcing opencode-sandbox-pre-start-container.sh"
  # shellcheck source=/dev/null
  source "${HOOK_PRE_START}"
fi

cleanup() {
  echo
  # shellcheck disable=SC2153  # CONTAINER_NAME is defined in shared
  echo "Stopping Container ${CONTAINER_NAME}..."
  "${CONTAINER_RUNTIME}" stop "${CONTAINER_NAME}" >/dev/null 2>&1 || true
}

trap cleanup INT TERM


if [[ ! -f "${OPENCODE_PASSWORD_FILE}" ]]; then
  echo "Missing sandbox build artifacts in ${OPENCODE_SANDBOX_DIR}."
  echo "Run ocs rebuild first."
  exit 1
fi

if ! "${CONTAINER_RUNTIME}" image inspect "${CONTAINER_NAME}" >/dev/null 2>&1; then
  echo "Container image ${CONTAINER_NAME} is not available locally."
  echo "Run ocs rebuild first."
  exit 1
fi

# Assemble the shared run flags (workspace + state + env + mounts + add-host)
build_run_flags

echo "Starting container ${CONTAINER_NAME} (opencode web)..."
echo ""
# shellcheck disable=SC2153  # PORT and LOCALHOST are defined in shared
echo "   container: ${CONTAINER_NAME}"
# shellcheck disable=SC2153
echo "   url:       http://${LOCALHOST}:${PORT}"
echo ""
for entry in "${RUN_LOG[@]}"; do echo "${entry}"; done
echo ""
echo "   https domains whitelisted:"
SQUID_WHITELIST="${OPENCODE_SANDBOX_DIR}/squid-whitelist.txt"
if [[ -f "${SQUID_WHITELIST}" ]]; then
  while IFS= read -r domain || [[ -n "${domain}" ]]; do
    echo "     ${domain}"
  done < "${SQUID_WHITELIST}"
fi
echo ""
echo "   host ports:"
HOST_PORTS_FILE="${OPENCODE_SANDBOX_DIR}/host-ports.txt"
if [[ -f "${HOST_PORTS_FILE}" ]]; then
  while IFS= read -r port || [[ -n "${port}" ]]; do
    echo "     docker.host:${port}"
  done < "${HOST_PORTS_FILE}"
  if [[ ! -s "${HOST_PORTS_FILE}" ]]; then
    echo "     (none)"
  fi
fi
echo ""
echo "   intranet endpoints:"
INTRANET_ENDPOINTS_FILE="${OPENCODE_SANDBOX_DIR}/intranet-endpoints.txt"
if [[ -f "${INTRANET_ENDPOINTS_FILE}" ]]; then
  while IFS= read -r endpoint || [[ -n "${endpoint}" ]]; do
    echo "     ${endpoint}"
  done < "${INTRANET_ENDPOINTS_FILE}"
  if [[ ! -s "${INTRANET_ENDPOINTS_FILE}" ]]; then
    echo "     (none)"
  fi
fi
echo ""
echo "---"
echo ""

"${CONTAINER_RUNTIME}" run --rm --init -it \
  --name "${CONTAINER_NAME}" \
  -e "OPENCODE_PORT=${PORT}" \
  -p "${LOCALHOST}:${PORT}:${PORT}" \
  "${RUN_FLAGS[@]}" \
  "${CONTAINER_NAME}"
