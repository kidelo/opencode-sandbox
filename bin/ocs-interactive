#!/usr/bin/env bash
set -euo pipefail

# ocs-interactive — start a one-shot container and drop into the opencode
# interactive terminal (TUI) as the 'dev' user. Squid + firewall are applied
# first by the entrypoint, so the session is sandboxed exactly like the web one.
# Ctrl+D (or /exit) in opencode ends the session; the container is removed.
#
# The last session is preserved (it lives in the persistent opencode state
# tree, mounted at /home/dev/.local/share/opencode), so an aborted TUI can be
# resumed:
#   ocs tui [name] -c            # continue the last session
#   ocs tui [name] -s <id>       # continue a specific session by id
#   ocs tui [name] --fork        # fork before continuing (with -c or -s)

# Source common configuration
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "${SCRIPT_DIR}/shared"

usage() {
  cat <<'EOF'
usage: ocs tui [name] [resume-flags]

Runs the opencode interactive TUI (one-shot, sandboxed). Resume options
(passed through to 'opencode'):
  -c, --continue        continue the last session (e.g. after an abort)
  -s, --session <id>    continue a specific session by id
      --fork            fork the session before continuing (needs -c or -s)
  -h, --help            show this help

'name' may be omitted when run from inside a sandbox project (it is then
resolved from the current directory), so 'ocs tui -c' resumes without naming
the project.
EOF
}

use_sandbox_root
print_sandbox_dir

# Parse the resume flags. An empty first arg is the dispatcher's "no name"
# placeholder — ignore it. Unknown args fail loudly instead of being dropped.
TUI_CONT=0
TUI_SES=""
TUI_FORK=0
while [[ $# -gt 0 ]]; do
  case "${1}" in
    "")             shift; continue ;;
    -h|--help)      usage; exit 0 ;;
    -c|--continue)
      [[ -z "${TUI_SES}" ]] || { echo "ocs tui: use either --continue OR --session <id>." >&2; usage >&2; exit 2; }
      TUI_CONT=1 ;;
    -s|--session)
      [[ $# -ge 2 && -n "${2:-}" ]] || { echo "ocs tui: --session requires a session id." >&2; usage >&2; exit 2; }
      case "${2}" in -*) echo "ocs tui: the --session id must not start with '-'." >&2; usage >&2; exit 2 ;; esac
      [[ ${TUI_CONT} -eq 0 ]] || { echo "ocs tui: use either --continue OR --session <id>." >&2; usage >&2; exit 2; }
      TUI_SES="${2}"; shift ;;
    --fork)         TUI_FORK=1 ;;
    *)              echo "ocs tui: unknown argument: ${1}" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

if [[ ${TUI_FORK} -eq 1 && ${TUI_CONT} -eq 0 && -z "${TUI_SES}" ]]; then
  echo "ocs tui: --fork requires --continue or --session <id>." >&2
  usage >&2
  exit 2
fi

# Per-project overrides from policy.txt (written by ocs-rebuild-container).
# MODEL:  use the project's `model:` key when set; otherwise the shared
#         OPENCODE_MODEL constant in bin/shared (kept as the fallback).
# TIMEOUT: wall-clock seconds; 0/empty => no limit.
POLICY_MODEL="$(read_policy model 2>/dev/null || true)"
MODEL="${POLICY_MODEL:-${OPENCODE_MODEL}}"
POLICY_TIMEOUT="$(read_policy timeout 2>/dev/null || true)"
[[ "${POLICY_TIMEOUT}" =~ ^[0-9]+$ ]] || POLICY_TIMEOUT=0

# Build the command the entrypoint evals as 'dev'. 'opencode' starts the TUI;
# provider/permissions come from the read-only opencode.jsonc, and the model is
# pinned explicitly with -m (the TUI does not read an OPENCODE_MODEL env var).
# The resume flags are appended as separate tokens, the session id shell-quoted
# so it survives the entrypoint's eval (same printf-%q discipline as ocs-run).
OPCODE_CMD="opencode --model $(printf '%q' "${MODEL}")"
[[ ${TUI_CONT} -eq 1 ]] && OPCODE_CMD="${OPCODE_CMD} --continue"
[[ -n "${TUI_SES}" ]] && OPCODE_CMD="${OPCODE_CMD} --session $(printf '%q' "${TUI_SES}")"
[[ ${TUI_FORK} -eq 1 ]] && OPCODE_CMD="${OPCODE_CMD} --fork"

# Human summary of the resume state (startup banner).
TUI_RESUME_DESC="fresh session (no resume flag)"
[[ ${TUI_CONT} -eq 1 ]] && TUI_RESUME_DESC="continue last session"
[[ -n "${TUI_SES}" ]] && TUI_RESUME_DESC="continue session: ${TUI_SES}"
[[ ${TUI_FORK} -eq 1 ]] && TUI_RESUME_DESC="${TUI_RESUME_DESC} (+fork)"

if [[ ! -f "${OPENCODE_PASSWORD_FILE}" ]]; then
  echo "Missing sandbox build artifacts in ${OPENCODE_SANDBOX_DIR}."
  echo "Run ocs rebuild first."
  exit 1
fi

if ! "${CONTAINER_RUNTIME}" image inspect "${CONTAINER_NAME}" >/dev/null 2>&1; then
  echo "Container image ${CONTAINER_NAME} is not available locally."
  echo "Run ocs rebuild first."
  exit 1
fi

if ! tty -s 2>/dev/null; then
  echo "ocs-interactive needs a TTY (it starts the opencode TUI)." >&2
  echo "Attach to a running web session with: ${SANDBOX_HOME}/bin/ocs-terminal" >&2
  exit 1
fi

build_run_flags

# Distinct name so a concurrent ocs-start-container (web) can keep running.
NAME="${CONTAINER_NAME}-tui-$$"

echo "Starting interactive opencode session (model: ${MODEL}) ..."
echo "   container: ${NAME}"
echo "   type:      interactive TUI (no web server)"
echo "   resume:    ${TUI_RESUME_DESC}"
if [[ "${POLICY_TIMEOUT}" -gt 0 ]]; then echo "   timeout:   ${POLICY_TIMEOUT}s"; fi
for entry in "${RUN_LOG[@]}"; do echo "${entry}"; done
echo "---"
echo ""

# OPCODE_CMD is eval'd by the entrypoint as the dev user (see the SC2016 note
# near the bottom of docker/entrypoint.sh). 'opencode' is on dev's PATH.
if [[ "${POLICY_TIMEOUT}" -gt 0 ]]; then
  exec timeout --foreground "${POLICY_TIMEOUT}" \
    "${CONTAINER_RUNTIME}" run --rm --init -it \
      --name "${NAME}" \
      -e "OPCODE_CMD=${OPCODE_CMD}" \
      "${RUN_FLAGS[@]}" \
      "${CONTAINER_NAME}"
else
  exec "${CONTAINER_RUNTIME}" run --rm --init -it \
    --name "${NAME}" \
    -e "OPCODE_CMD=${OPCODE_CMD}" \
    "${RUN_FLAGS[@]}" \
    "${CONTAINER_NAME}"
fi
